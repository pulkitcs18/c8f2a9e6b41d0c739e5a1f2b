# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Action Network Credentials
ACTION_NETWORK_EMAIL=your_action_network_email@example.com
ACTION_NETWORK_PASSWORD=your_action_network_password

# Optional: Sport to scrape (default: nba)
SPORT=nba

# Lovable API
LOVABLE_API_ENDPOINT=https://your-lovable-endpoint-here
LOVABLE_API_KEY=your_lovable_api_key_here
